# MedCare IA — Entorno local (.env.example)
# Copiar a .env y ajustar según el entorno.

# Entorno: development | test | production
APP_ENV=development

# Prefijo global de la API (vacío = raíz)
API_PREFIX=

# URL base del dataset Kaggle (C0-3 / C1-1)
# DATASET_URL=

# Ruta del artefacto del modelo entrenado (C1-1 / C4-1)
MODEL_PATH=models/model.joblib

# URL de la API Core .NET (para cronjob batch y auth M2M — Sprint 2+)
# CORE_API_URL=http://localhost:5000
# CORE_TOKEN=

# Credenciales Supabase (si se usa lectura vía API en producción)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=